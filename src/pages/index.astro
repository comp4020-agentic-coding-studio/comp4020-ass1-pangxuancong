---
import Layout from "../layouts/Layout.astro";
import {
  CHART_HEIGHT,
  CHART_WIDTH,
  MARGIN,
  PRINCIPAL,
  RATE,
  YEARS,
  xForYear,
  yForValue,
} from "../scripts/compound";

const yTicks = [0, 5000, 10000, 15000, 20000];
const xTicks = [0, 5, 10, 15, 20, 25, 30];
---

<Layout title="Why we underestimate compound interest">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Why we underestimate compound interest</h1>
    <p>
      ${PRINCIPAL.toLocaleString("en-US")} invested at {RATE * 100}% a year,
      left untouched for {YEARS} years. Before you scroll on: guess what it's
      worth.
    </p>

    <section data-testid="predictor">
      <label for="guess-slider">
        Your guess:
        <output for="guess-slider" id="guess-value" data-testid="guess-value"
          >${PRINCIPAL.toLocaleString("en-US")}</output
        >
      </label>
      <input
        type="range"
        id="guess-slider"
        data-testid="guess-slider"
        min="0"
        max="20000"
        step="100"
        value={PRINCIPAL}
      />
      <button type="button" data-testid="reveal-button">Reveal</button>
    </section>

    <svg
      data-testid="growth-chart"
      viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`}
      role="img"
      aria-label={`Growth of $${PRINCIPAL} at ${RATE * 100}% over ${YEARS} years, compared to your guess`}
    >
      {
        yTicks.map((tick) => (
          <g>
            <line
              x1={MARGIN.left}
              y1={yForValue(tick)}
              x2={CHART_WIDTH - MARGIN.right}
              y2={yForValue(tick)}
              class="gridline"
            />
            <text
              x={MARGIN.left - 8}
              y={yForValue(tick)}
              class="tick-label"
              text-anchor="end"
              dominant-baseline="middle"
            >
              ${tick / 1000}k
            </text>
          </g>
        ))
      }
      {
        xTicks.map((year) => (
          <text
            x={xForYear(year)}
            y={CHART_HEIGHT - MARGIN.bottom + 18}
            class="tick-label"
            text-anchor="middle"
          >
            {year}
          </text>
        ))
      }
      <line
        x1={MARGIN.left}
        y1={MARGIN.top}
        x2={MARGIN.left}
        y2={CHART_HEIGHT - MARGIN.bottom}
        class="axis"
      />
      <line
        x1={MARGIN.left}
        y1={CHART_HEIGHT - MARGIN.bottom}
        x2={CHART_WIDTH - MARGIN.right}
        y2={CHART_HEIGHT - MARGIN.bottom}
        class="axis"
      />
      <line
        data-testid="guess-marker"
        x1={MARGIN.left}
        x2={CHART_WIDTH - MARGIN.right}
        y1={yForValue(PRINCIPAL)}
        y2={yForValue(PRINCIPAL)}
        class="guess-marker"
      />
      <path data-testid="actual-curve" class="actual-curve is-hidden" d="" />
      <text
        data-testid="guess-marker-label"
        x={CHART_WIDTH - MARGIN.right + 6}
        y={yForValue(PRINCIPAL)}
        class="marker-label guess-label"
        text-anchor="start"
        dominant-baseline="middle"
      >
        ${PRINCIPAL.toLocaleString("en-US")}
      </text>
      <text
        data-testid="actual-curve-label"
        x={CHART_WIDTH - MARGIN.right + 6}
        y={yForValue(PRINCIPAL)}
        class="marker-label actual-label is-hidden"
        text-anchor="start"
        dominant-baseline="middle"
      />
    </svg>

    <ul class="chart-legend" data-testid="chart-legend">
      <li>
        <span class="legend-swatch legend-guess"></span>
        Your guess (linear growth)
      </li>
      <li>
        <span class="legend-swatch legend-actual"></span>
        Actual growth (compound interest)
      </li>
    </ul>

    <section data-testid="result" hidden>
      <p>It's actually worth <strong data-testid="actual-value" />.</p>
      <div data-testid="explanation">
        <p data-testid="explain-first-decade">
          First 10 years: <span data-testid="explain-first-start" /> →
          <span data-testid="explain-first-end" /><br />
          gain: +<span data-testid="explain-first-gain" />
        </p>
        <p data-testid="explain-last-decade">
          Final 10 years: <span data-testid="explain-last-start" /> →
          <span data-testid="explain-last-end" /><br />
          gain: +<span data-testid="explain-last-gain" />
        </p>
        <p data-testid="explain-callout">
          The last 10 years create more growth than the first 20 years
          combined.
        </p>
      </div>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
